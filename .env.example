# 记忆中枢环境变量示例配置（见设计规范 17.5 节）

# 数据库连接
HUB_DB_URL=postgresql://hub_app:secret@localhost:5432/memory_hub?sslmode=disable

# 嵌入模型（为空时使用 MockEmbedder）
HUB_EMBED_MODEL_PATH=
HUB_EMBED_DIM=1024

# 检索与装配预算
HUB_TOKEN_BUDGET_DEFAULT=600
HUB_SOFT_TIMEOUT_MS=300
HUB_RETRIEVAL_FTS_K=20
HUB_RETRIEVAL_VEC_K=20
HUB_SCORE_WEIGHTS=0.40,0.20,0.15,0.10,0.15
HUB_MMR_LAMBDA=0.7

# 记忆升格与判定门槛
HUB_PROMOTE_MIN_OBS=3
HUB_PROMOTE_MIN_CONTEXTS=2
HUB_PROMOTE_MIN_SPAN_DAYS=7
HUB_PROMOTE_MIN_CONF=0.7
HUB_MARGIN_DELTA=0.15
HUB_DECAY_TAU_DAYS=state:7,preference:90,relation:365,behavior:90,goal_belief:180

# 时效与令牌
HUB_IDEMPOTENCY_TTL_H=24
HUB_CONFIRM_TOKEN_TTL_S=120
HUB_EXPORT_LINK_TTL_H=24
AS_ACCESS_TOKEN_TTL_S=900
AS_REFRESH_TOKEN_TTL_D=30
AS_AUTH_CODE_TTL_S=60

# 限流与安全
RATE_LIMIT_PER_CLIENT_RPS=50
RATE_LIMIT_PER_USER_RPS=10
MAX_REQUEST_BYTES=65536
LOG_REDACTION=always

# 特性开关
FEATURE_NATIONAL_MEMORY=false
FEATURE_LEDGER_AVAILABLE=true
FEATURE_ADAPTER_GATEWAY=false
