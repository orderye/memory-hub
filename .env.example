# 多智能体长期记忆服务 · 环境变量示例（见 docs/设计-多智能体长期记忆服务.md）
#
# 所有配置项均由 common::AppConfig 从环境变量读取并在启动期强校验；
# 非法配置直接 fail-fast 退出，绝不带病进入运行态。

# ===== 部署形态（Lite / Production）=====
# production（默认）：完整生产部署。三个进程、向量检索、后台周期作业、多账户隔离全部保留。
#                     **不带任何改动升级时行为不变**——默认值即历史行为。
# lite               ：个人轻量部署（单机、少量 Agent）。只改两个默认值：
#                      · HUB_EMBED_PROVIDER=off（写入不落向量、检索纯关键词、整合零嵌入调用）
#                      · EXPIRY_SWEEP_INTERVAL_H=0（不跑周期性清扫，改为手动 backup-worker --once）
#                     其余能力（PostgreSQL/pgvector、OAuth 2.1、ACL、备份恢复、认知记忆、
#                     全部 28 个 MCP 工具）**一项不减**。
#
# 语义边界：本变量只提供"默认值"。任何显式设置的变量都会覆盖它，
# 它也不会改写令牌、授权、日志脱敏等安全项。未知值启动即失败。
HUB_DEPLOYMENT_PROFILE=production

# ===== 内嵌后台作业（可选）=====
# 在 mcp-server 进程内跑 backup-worker 的常驻作业（定时备份 / 过期清理 / 证据清理 /
# 整合扫描，同一 cron 与跨进程租约），部署从三进程收敛为两进程。
# 默认 false（不带改动升级时行为不变）；不新增任何进程，lite 的"不养空转进程"不受影响。
# 开启后无需再常驻 backup-worker；手动 `backup-worker --once` 仍可用于运维触发。
HUB_EMBEDDED_WORKER=false

# ===== 存储 =====
# PostgreSQL 15+ / pgvector 连接串（auth-server 与 mcp-server 共享同一库）
HUB_DB_URL=postgresql://hub_app:secret@localhost:5432/memory_hub?sslmode=disable
# docker-compose 使用的库口令：**必填**（compose 里已去掉内置默认口令，未设置则拒绝启动）
POSTGRES_PASSWORD=
# 单实例数据库连接池上限。多副本部署时注意总连接数不要超过 PostgreSQL max_connections（docker-compose 默认设为 200）
HUB_DB_MAX_CONNECTIONS=10
# 单条 SQL 的服务器端超时（毫秒）；0 = 不限制。迁移执行期会自动关闭该限制，不受影响
HUB_DB_STATEMENT_TIMEOUT_MS=30000
# PostgreSQL 连接失败时是否退回内存存储（默认 false；内存存储重启即失忆）
HUB_STORE_FALLBACK_MEMORY=false

# ===== 线程与并发控制 =====
# Tokio 异步运行时工作线程数（建议与容器 CPU 限制 1:1 对齐；留空则默认使用系统物理核数）
TOKIO_WORKER_THREADS=2

# ===== 嵌入模型 =====
# 提供方：off（显式关闭）| mock（确定性伪向量，开发/测试）| http（OpenAI 兼容 /embeddings 服务）
#
# off：不计算任何向量、不访问任何嵌入端点，条目以 embedding=NULL 落库，
#      检索为纯关键词模式。个人轻量部署的默认值；配了 endpoint 也会被忽略。
#
# ⚠️ 生产必须用 http：mock 的余弦相似度是**噪声**不是语义。
#    系统会识别伪向量并把向量维度排除在打分之外（此时检索退化为词法检索），
#    且 `GET /readyz` / `GET /capabilities` 会返回 `semantic.ready = false`。
#    "接口能返回结果"不等于"语义检索可用"。
# 留空/注释掉 = 使用部署模式默认值：production 下为 mock，lite 下为 off。
# 之所以不在这里显式写 mock：docker-compose.lite.yml 用 `${HUB_EMBED_PROVIDER:-off}`
# 做插值，一旦这里写了 mock，Lite 的"零嵌入"就会名不副实。
# HUB_EMBED_PROVIDER=mock
# provider=http 时必填
HUB_EMBED_ENDPOINT=https://embed.example.com/v1/embeddings
HUB_EMBED_API_KEY=
HUB_EMBED_MODEL=bge-m3
# 注意：PostgreSQL 后端要求此值与迁移脚本中的 vector(1024) 一致
HUB_EMBED_DIM=1024

# ===== 服务监听地址 =====
HUB_MCP_BIND=0.0.0.0:3000
AUTH_BIND=0.0.0.0:8080
# auth-server 对外基准地址（元数据/控制台链接拼装）
AUTH_EXTERNAL_BASE_URL=http://localhost:8080

# ===== 鉴权与令牌 =====
# 访问令牌签名密钥（HS256）。授权服务器与 MCP 服务必须使用同一值。
# 启动期强校验：不得为空、不得少于 32 字节、不得是内置占位值 `dev-only-insecure-secret`，
# 否则进程直接拒绝启动。生成方式：`openssl rand -hex 32`
HUB_TOKEN_SECRET=please-replace-with-strong-random-secret
# 签发方标识（iss）
AUTH_ISSUER=https://auth.memory-hub.local
# 中枢资源 URI（aud，RFC 8707 资源指示符）
HUB_RESOURCE_URI=https://hub.memory-hub.local
AS_ACCESS_TOKEN_TTL_S=3600
HUB_CONFIRM_TOKEN_TTL_S=120
# 注意：`POST /oauth/introspect` 与 `POST /oauth/revoke` 现在要求客户端认证
# （HTTP Basic client_id:client_secret，或表单 client_id/client_secret 字段），
# 且撤销只能作用于本客户端自己的刷新令牌族（RFC 7662 §2.1 / RFC 7009 §2.1）。

# ===== 账户（沙箱隔离）=====
# 引导账户用户名：升级后的存量数据整体归属该账户；auth-server 用它初始化
HUB_BOOTSTRAP_USERNAME=bootstrap
# 引导账户口令（设置后可用它登录控制台；不设置则引导账户仅用于数据归属）
HUB_BOOTSTRAP_PASSWORD=
# 账户注册邀请码（留空 = 开放注册；个人部署建议设置防陌生人）
AUTH_INVITE_CODE=
# 账户登录会话有效期（小时；默认 720 = 30 天）
AUTH_SESSION_TTL_H=720

# ===== 检索 =====
HUB_SOFT_TIMEOUT_MS=500
HUB_RETRIEVAL_FTS_K=100
HUB_RETRIEVAL_VEC_K=100
# 五维权重：sim, kw, conf, rec, prior（层级先验；之和必须为 1）
HUB_SCORE_WEIGHTS=0.50,0.20,0.10,0.10,0.10
HUB_MMR_LAMBDA=0.7
# 近期性时间常数覆盖（天；不设置则按记忆类型自动区分）
# HUB_RETRIEVAL_RECENCY_TAU_DAYS=30
# 场景模式：strict（默认硬过滤）/ prefer（软偏好，需评测确认后开启）
HUB_RETRIEVAL_SCENE_MODE=strict
# 分场景五维权重（sim,kw,conf,rec,prior；每套权重之和必须为 1，缺省用全局权重）
# HUB_SCENE_WEIGHT_PROFILES=chat=0.45,0.20,0.10,0.15,0.10;coding=0.45,0.25,0.10,0.05,0.15
# 默认最小可信分（域外拒绝阈值）：低于此分的候选一律丢弃；一条不剩时
# memory_search 返回 no_reliable_match=true（明确说"没找到可靠的"，而不是硬凑低分结果）。
# 0 = 关闭该阈值。**默认 0.65 是在伪向量模态下标定的，接真实嵌入模型后必须重新标定**
# （HUB_EVAL_CALIBRATE=1 跑标定曲线）。
HUB_RETRIEVAL_MIN_SCORE=0.65
# 分场景最小可信分覆盖（缺省回落到上面的全局值）
# HUB_SCENE_MIN_SCORE_PROFILES=chat=0.70;working=0.60

# ===== 备份 =====
# 每个命名空间保留的快照份数（超出后淘汰最旧）
BACKUP_KEEP_COUNT=10
# 快照保留天数（0 = 仅按份数淘汰；至少保留最新 1 份）
BACKUP_RETENTION_DAYS=90
# 单次快照最大条目数（防备份膨胀）
BACKUP_MAX_ENTRIES=50000
# 定时备份 cron（5 段：分 时 日 月 周；启动期解析，非法即 fail-fast）
BACKUP_CRON=0 3 * * *

# ===== 证据保留 =====
# 不可变证据的保留期限（天）；到期由 backup-worker 物理删除，0 = 永久保留。
# 证据写入前已做凭证脱敏与最小化摘要，本项是第二道防线。
HUB_EVIDENCE_RETENTION_DAYS=90

# ===== 整合（去重 / 冲突归并）=====
# 判定"重复"的余弦相似度阈值（向量模式下的重复带下界）
INTEGRATE_SIM_THRESHOLD=0.92
# 单次扫描最多生成的提案数
INTEGRATE_MAX_PROPOSALS=100
# 过期记忆清理间隔（小时；0 = backup-worker 不跑清理）
EXPIRY_SWEEP_INTERVAL_H=6
# 单命名空间单次整合扫描最多装载的活跃条目数（0 = 不限制，默认 2000）。
# 整合是"整库读入 → O(n²) 候选发现"的操作，没有上限时大命名空间会顶满内存。
# 超过上限时只扫描最近更新的 N 条，并在 memory_consolidate / memory_integrate_scan
# 的报告里返回 truncated=true（不会静默截断）。
HUB_INTEGRATION_SCAN_MAX_ENTRIES=2000
# 后台作业跨进程租约窗口（小时；0 = 关闭租约）。
# 多副本部署时让"同一命名空间整合扫描 / 备份 / 证据清理"在一个窗口内只被一个副本执行。
# 复用 rate_limit_buckets 表实现，不需要额外迁移。
HUB_JOB_LEASE_H=24
# 整合健康度统计缓存（秒；0 = 每次重算）。
# memory_consolidation_stats 每次调用都做一遍全库候选分析，缓存可挡掉面板轮询；
# 命中缓存时响应里 cached=true / cache_age_s=N，调用方不会误当成实时结论。
HUB_CONSOLIDATION_STATS_TTL_S=60

# ===== 经验资产治理（任务书 P2）=====
# 经验从 candidate 升级为 active（已验证）所需的最少“不同已完成来源任务”数。
# - 单次成功不足以验证通用经验，默认要求 2 个来源；
# - 关联任务中存在 failed 时一律拒绝升级；
# - 该门槛只影响显式 working_experience_transition(verify)，不影响提炼（只产出 candidate）。
# 取值范围 1–10；越界会在启动时直接失败，不做静默回退。
HUB_EXPERIENCE_VERIFY_MIN_SOURCES=2

# ===== 记忆整合模式（A / B）=====
# 候选发现模式：
#   rules  = 纯本地规则整合（默认）：只用规范化指纹、结构化字段与本地词法索引，
#            **一次嵌入调用都不会发出**，记忆内容不会离开本机；
#   hybrid = 向量辅助整合：规则候选 + 嵌入向量召回的语义候选。
#
# ⚠️ 配置了 HUB_EMBED_PROVIDER=http **不会**自动切到 hybrid：
#    是否把记忆内容送到外部嵌入端点必须由管理员显式决定。
#    未知值启动即失败（fail-fast），绝不静默猜测。
HUB_CONSOLIDATION_MODE=rules
# hybrid 不可用时（provider 未配置 / 伪向量 / 调用失败）的降级策略：
#   rules = 降级为纯规则整合，并在响应里如实上报
#          requested_mode=hybrid / effective_mode=rules / fallback_applied=true；
#   error = 直接返回可诊断错误，不执行任何整合（不会留下半合并状态）。
HUB_CONSOLIDATION_FALLBACK=rules
# stdio 本地桥接身份（仅 HUB_SERVE_MODE=stdio 生效）。
# 留空 = stdio 下的 tools/call 与 HTTP 一样必须带 Bearer 令牌（默认，最安全）。
# 设置为一个 Agent 名 = 把 stdio 会话视为"进程所有者本人的本地桥接"，
# 以 bootstrap 账户 + 全部 scope + 通配 ACL 运行（单机个人部署用；会打印 WARN）。
# 只影响 stdio；HTTP 路径仍严格校验 OAuth 2.1 令牌与 ACL。
HUB_STDIO_LOCAL_AGENT=

# 是否允许 MCP 单次请求用 `mode` 参数覆盖服务端模式。
# 默认 false：逐次切换模式等于逐次决定"要不要把记忆内容发出去"，应由管理员统一控制。
HUB_CONSOLIDATION_ALLOW_MODE_OVERRIDE=false
# hybrid 单次扫描最多新计算向量的条目数（1~200）。已存且模型兼容的向量会直接复用，不计入。
HUB_CONSOLIDATION_EMBED_TOP_K=20
# hybrid 语义候选的相似度下限（0~1）。
# **留空 = 未经真实模型标定**：此时回落到 INTEGRATE_SIM_THRESHOLD，并在响应里标记
# similarity_threshold_calibrated=false。禁止复用检索的 HUB_RETRIEVAL_MIN_SCORE
# （那是检索阈值，与整合候选门槛不是一回事）。
# HUB_CONSOLIDATION_EMBED_MIN_SIMILARITY=0.90
# 纯规则模式的词法候选相似度下限（Jaccard，0~1）
HUB_CONSOLIDATION_LEXICAL_MIN_SIMILARITY=0.80

# ===== 时效与限流 =====
HUB_IDEMPOTENCY_TTL_H=24
# 单 Agent 每秒请求上限（0 = 不限流）
RATE_LIMIT_PER_AGENT_RPS=50
MAX_REQUEST_BYTES=262144
# 允许的 Origin 白名单（逗号分隔）；留空表示不校验，仅限本地桥接
ALLOWED_ORIGINS=
# 可信反向代理列表（逗号分隔的精确 IP，仅 IPv4/IPv6，不支持 CIDR）。
# 仅当请求的 TCP 对端地址在列表内时，auth-server 才解析 X-Forwarded-For
# 作为 IP 限流的客户端地址；留空（默认）= 完全不信任 XFF，一律用 socket
# 对端地址。经过反向代理/Nginx/Caddy 部署时必须配置，否则代理后所有用户
# 共享同一个限流桶（互相触发 429）；配错（写了 CIDR 或域名）启动即失败。
TRUSTED_PROXIES=
LOG_REDACTION=always
